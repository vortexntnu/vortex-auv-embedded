{
    "version": "1.7",
    "configurations": [
        {
            "name": "default",
            "id": "conf1",
            "device": "ATSAMC21J18A",
            "imagePath": "./out/bms/default.elf",
            "packs": [
                {
                    "name": "SAMC21_DFP",
                    "vendor": "Microchip",
                    "version": "3.9.248"
                },
                {
                    "name": "CMSIS",
                    "vendor": "ARM",
                    "version": "6.2.0"
                }
            ],
            "fileSet": "default",
            "toolchain": "default-XC32"
        }
    ],
    "propertyGroups": [
        {
            "name": "default-XC32",
            "type": "toolchain",
            "provider": "microchip.toolchains:xc32@4.60",
            "properties": {
                "compiler.isolate-each-function": true,
                "compiler.place-data-into-section": true,
                "compiler.optimization-level": "-O1",
                "compiler.extra-include-directories": [
                    "bms_config/src",
                    "bms_config/src/config/default",
                    "bms_config/src/ic_bms",
                    "bms_config/src/packs/ATSAMC21J18A_DFP",
                    "bms_config/src/packs/CMSIS",
                    "bms_config/src/packs/CMSIS/CMSIS/Core/Include"
                ],
                "compiler.make-warnings-into-errors": true,
                "compiler.additional-warnings": true,
                "compiler++.isolate-each-function": true,
                "compiler++.optimization-level": "-O1",
                "compiler++.extra-include-directories": [
                    "bms_config/src",
                    "bms_config/src/config/default",
                    "bms_config/src/ic_bms",
                    "bms_config/src/packs/ATSAMC21J18A_DFP",
                    "bms_config/src/packs/CMSIS",
                    "bms_config/src/packs/CMSIS/CMSIS/Core/Include"
                ],
                "linker.heap-size": "512",
                "linker.remove-unused-sections": true,
                "linker.no-device-startup-code": "true",
                "linker.preprocessor-macros": []
            }
        }
    ],
    "fileSets": [
        {
            "name": "default",
            "files": [
                {
                    "include": "**/*",
                    "exclude": "**/(_build|out|cmake|.vscode)/**/*"
